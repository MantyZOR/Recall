<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="CanvasBrush" Color="#F4F6FA"/>
  <SolidColorBrush x:Key="PaperBrush" Color="#FCFDFE"/>
  <SolidColorBrush x:Key="LineBrush" Color="#CDD5E3"/>
  <SolidColorBrush x:Key="InkBrush" Color="#222D40"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#515F75"/>
  <SolidColorBrush x:Key="BlueBrush" Color="#DBE8F8"/>
  <SolidColorBrush x:Key="BlueInk" Color="#27466D"/>
  <SolidColorBrush x:Key="LilacBrush" Color="#E9E2F4"/>
  <SolidColorBrush x:Key="LilacInk" Color="#52436E"/>
  <SolidColorBrush x:Key="RoseBrush" Color="#F4DFE2"/>
  <SolidColorBrush x:Key="RoseInk" Color="#783B4A"/>
  <Style TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="PanelBorder" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="16"/>
  </Style>
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="Padding" Value="13,7"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Plate" Property="BorderBrush" Value="#8196B4"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource BlueInk}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Plate" Property="Opacity" Value="0.8"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Plate" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource BlueInk}"/>
    <Setter Property="BorderBrush" Value="#B9CCE5"/>
  </Style>
  <Style x:Key="LilacButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource LilacBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource LilacInk}"/>
    <Setter Property="BorderBrush" Value="#D2C6E3"/>
  </Style>
  <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource RoseBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource RoseInk}"/>
    <Setter Property="BorderBrush" Value="#E1BAC2"/>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="Padding" Value="9,6"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="MinHeight" Value="30"/>
  </Style>
  <Style TargetType="Expander">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton Content="{TemplateBinding Header}" Cursor="Hand" Padding="1,2"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="HeaderPlate" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1" Background="Transparent">
                    <DockPanel>
                      <TextBlock x:Name="Arrow" DockPanel.Dock="Left" Width="20" Foreground="{StaticResource BlueInk}" Text="▸"/>
                      <ContentPresenter VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Arrow" Property="Text" Value="▾"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="HeaderPlate" Property="Background" Value="{StaticResource CanvasBrush}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                      <Setter TargetName="HeaderPlate" Property="BorderBrush" Value="{StaticResource BlueInk}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
