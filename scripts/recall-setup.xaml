<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recall — установка" Width="658" Height="558" MinWidth="610" MinHeight="530" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}">
  <Window.Resources><!-- RECALL_THEME --></Window.Resources>
  <Grid Background="{StaticResource CanvasBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Padding="24,17" Background="{StaticResource BlueBrush}" BorderBrush="#B9CCE5" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image x:Name="BrandIcon" Width="40" Height="40" Margin="0,0,13,0" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1">
          <TextBlock Text="WINDOWS  /  RECALL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BlueInk}"/>
          <TextBlock x:Name="Heading" Text="Установка Recall" FontSize="28" FontWeight="SemiBold" Margin="0,2,0,0"/>
        </StackPanel>
        <Border Grid.Column="2" VerticalAlignment="Center" Background="{StaticResource LilacBrush}" Padding="10,6" Margin="12,0,0,0">
          <TextBlock x:Name="VersionText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource LilacInk}"/>
        </Border>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,18,24,16">
        <Border Style="{StaticResource PanelBorder}">
          <StackPanel>
            <TextBlock Text="Папка установки" Style="{StaticResource SectionLabel}"/>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="Destination" AutomationProperties.Name="Папка установки" FontFamily="Consolas" Padding="9,7"/>
              <Button x:Name="Browse" Grid.Column="1" Margin="8,0,0,0" MinWidth="92" Content="Обзор…"/>
            </Grid>
            <TextBlock x:Name="PathHint" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource PanelBorder}" Margin="0,10,0,0" Background="#F4F0F9">
          <StackPanel>
            <TextBlock Text="Данные" Style="{StaticResource SectionLabel}"/>
            <TextBlock x:Name="DataHint" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            <WrapPanel x:Name="Migration" Margin="0,9,0,0">
              <Button x:Name="ChooseSource" Content="Выбрать старую папку…" MinHeight="34"/>
              <Button x:Name="ResetSource" Content="Сбросить" Margin="8,0,0,0" MinHeight="34"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <StackPanel Margin="0,10,0,0">
          <CheckBox x:Name="DesktopLink" IsChecked="True" Content="Ярлык на рабочем столе"/>
          <CheckBox x:Name="LaunchAfter" IsChecked="True" Content="Открыть Recall после установки"/>
        </StackPanel>
        <TextBlock x:Name="Message" Margin="0,8,0,0" Foreground="{StaticResource RoseInk}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{StaticResource PaperBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,13">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Для текущего пользователя" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button x:Name="Cancel" Grid.Column="1" MinWidth="86" Content="Закрыть"/>
        <Button x:Name="Run" Grid.Column="2" MinWidth="125" Margin="8,0,0,0" IsDefault="True" Content="Установить" Style="{StaticResource PrimaryButton}"/>
      </Grid>
    </Border>
  </Grid>
</Window>
