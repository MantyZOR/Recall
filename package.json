{
  "name": "recall-local",
  "private": true,
  "version": "0.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/generate-import-guide.mjs && tsc -b && node scripts/generate-wiki.mjs && vite build && node scripts/generate-sw.mjs",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup:tls": "node scripts/setup-tls.mjs",
    "build:launcher": "node scripts/build-launcher.mjs",
    "package:source": "node scripts/package-release.mjs source",
    "package:portable": "node scripts/package-release.mjs portable",
    "build:web": "node scripts/build-web.mjs",
    "publish:web": "npm run build:web && node scripts/publish-web.mjs"
  },
  "dependencies": {
    "@peculiar/x509": "^2.1.0",
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "katex": "0.16.47",
    "lucide-react": "^1.50.0",
    "multicast-dns": "7.2.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
